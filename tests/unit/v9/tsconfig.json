{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../..",
    "rootDir": "../../..",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@mui-flexy/core": [
        "packages/core/src"
      ],
      "@mui-flexy/v9": [
        "packages/v9/src"
      ],
      "@mui-flexy/v9/*": [
        "packages/v9/src/*"
      ],
      "@mui/material": [
        "./packages/v9/node_modules/@mui/material"
      ],
      "@mui/material/*": [
        "./packages/v9/node_modules/@mui/material/*"
      ],
      "@mui/system": [
        "./packages/v9/node_modules/@mui/system"
      ],
      "@mui/system/*": [
        "./packages/v9/node_modules/@mui/system/*"
      ],
      "@mui/styles": [
        "./packages/v9/node_modules/@mui/styles"
      ],
      "@mui/styles/*": [
        "./packages/v9/node_modules/@mui/styles/*"
      ],
      "@mui/utils": [
        "./packages/v9/node_modules/@mui/utils"
      ],
      "@mui/utils/*": [
        "./packages/v9/node_modules/@mui/utils/*"
      ],
      "@emotion/react": [
        "./packages/v9/node_modules/@emotion/react"
      ],
      "@emotion/styled": [
        "./packages/v9/node_modules/@emotion/styled"
      ]
    }
  },
  "include": [
    "./**/*",
    "../shared/**/*",
    "../../../packages/v9/src/**/*"
  ]
}
