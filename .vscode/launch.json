{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "name": "Test: run jest tests",
      "request": "launch",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "program": "${workspaceRoot}/node_modules/.bin/jest",
      "cwd": "${workspaceFolder}",
      "args": [
        "test",
        "--runInBand",
        "--watchAll=false"
      ]
    },
    {
      "name": "Test: Core Package (watch)",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/packages/core",
      "request": "launch",
      "command": "pnpm run test --watch"
    },
    {
      "name": "Fixture: v5 Server",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/fixtures/v5",
      "request": "launch",
      "command": "pnpm run dev",
      "serverReadyAction": {
        "pattern": "webpack compiled|Local:.*http://localhost:3005",
        "uriFormat": "http://localhost:3005",
        "action": "openExternally"
      }
    },
    {
      "name": "Fixture: v6 Server",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/fixtures/v6",
      "request": "launch",
      "command": "pnpm run dev",
      "serverReadyAction": {
        "pattern": "webpack compiled|Local:.*http://localhost:3006",
        "uriFormat": "http://localhost:3006",
        "action": "openExternally"
      }
    },
    {
      "name": "Fixture: v7 Server",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/fixtures/v7",
      "request": "launch",
      "command": "pnpm run dev",
      "serverReadyAction": {
        "pattern": "webpack compiled|Local:.*http://localhost:3007",
        "uriFormat": "http://localhost:3007",
        "action": "openExternally"
      }
    },
    {
      "name": "Fixture: v9 Server",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}/fixtures/v9",
      "request": "launch",
      "command": "pnpm run dev",
      "serverReadyAction": {
        "pattern": "webpack compiled|Local:.*http://localhost:3008",
        "uriFormat": "http://localhost:3008",
        "action": "openExternally"
      }
    },
    {
      "name": "Demo & docs: Development Server",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "command": "pnpm run demo",
      "serverReadyAction": {
        "pattern": "webpack compiled|Local:.*http://localhost:3003",
        "uriFormat": "http://localhost:3003",
        "action": "openExternally"
      }
    },
    {
      "name": "Demo & docs: Build and Serve",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "command": "pnpm run build:docs && pnpm run docs:serve"
    },
    {
      "name": "Build: All Packages",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "command": "pnpm run build"
    },
    {
      "name": "Test: All Packages",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "command": "pnpm run test"
    },
    {
      "name": "Test: Unit Tests (Watch Mode)",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "command": "pnpm run test:unit --watch"
    },
    {
      "name": "Test: TypeScript Types",
      "type": "node-terminal",
      "cwd": "${workspaceFolder}",
      "request": "launch",
      "command": "pnpm run typecheck"
    },
    {
      "type": "node",
      "name": "vscode-jest-tests.v2.mui-flexy",
      "request": "launch",
      "args": [
        "--runInBand",
        "--watchAll=false",
        "--no-cache",
        "--testNamePattern",
        "${jest.testNamePattern}",
        "--runTestsByPath",
        "${jest.testFile}",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "sourceMaps": true,
      "env": {
        "NODE_ENV": "test",
        "NODE_OPTIONS": "--experimental-vm-modules"
      }
    }
  ],
  "compounds": [
    {
      "name": "Fixture: All",
      "configurations": [
        "Fixture: v5 Server",
        "Fixture: v6 Server",
        "Fixture: v7 Server",
        "Fixture: v9 Server"
      ],
      "stopAll": true
    }
  ]
}